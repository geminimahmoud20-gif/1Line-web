rules_version = '2';
// Firebase Storage rules — CMS media only (hero videos, images).
// Mirrors isAdmin() in firestore.rules. Deploy: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') in ['admin', 'super_admin'] ||
        request.auth.uid == 'dB6GM2RoPQRE0iksDnqcdvUKgXy2'
      );
    }

    // Public site media: anyone can view; only the admin uploads, within type/size limits
    match /cms/videos/{file} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
      allow delete: if isAdmin();
    }
    match /cms/images/{file} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    // Everything else is closed
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
