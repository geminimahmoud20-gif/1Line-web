rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role in ['admin', 'super_admin'] ||
        request.auth.uid == 'dB6GM2RoPQRE0iksDnqcdvUKgXy2'
      );
    }
    
    // 🛡️ 1. LEADS & CUSTOMER INQUIRIES (حماية بيانات العملاء والطلبات)
    match /leads/{leadId} {
      allow create: if request.resource.data.phone is string 
                    && request.resource.data.phone.size() >= 10
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2;
      allow read, update, delete: if request.auth != null && (request.auth.token.admin == true || isAdmin());
    }
    
    // 📋 2. DEMANDS & CLIENT REQUESTS (طلبات العقارات المخصصة)
    match /demands/{demandId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.phone is string 
                    && request.resource.data.phone.size() >= 10;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // 🏠 3. PROPERTIES INVENTORY (مخزون العقارات)
    match /properties/{propId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.admin == true || isAdmin());
    }

    // 🔔 4. NOTIFICATIONS (سجل الإشعارات)
    match /notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    // 📜 5. AUDIT LOGS (سجل التدقيق المؤسسي غير القابل للتعديل)
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Strict immutability of audit records
    }

    // ⚙️ 6. SITE & FOUNDER SETTINGS (إعدادات الموقع والمؤسس وأرقام التواصل الحية)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🏢 7. PROJECTS & MEGA DEVELOPMENTS (المشروعات والكمبوندات الكبرى)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 📢 8. SPONSORED ADS & CAMPAIGNS (الحملات الإعلانية ومساحات الرعاة)
    match /advertisements/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
