rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == 'dB6GM2RoPQRE0iksDnqcdvUKgXy2'
      );
    }
    
    // 🛡️ 1. LEADS & CUSTOMER INQUIRIES (حماية بيانات العملاء والطلبات)
    match /leads/{leadId} {
      allow create: if request.resource.data.phone is string 
                    && request.resource.data.name is string;
      allow read, update, delete: if request.auth != null && (request.auth.token.admin == true || isAdmin());
    }
    
    // 📋 2. DEMANDS & CLIENT REQUESTS (طلبات العقارات المخصصة)
    match /demands/{demandId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 🏠 3. PROPERTIES INVENTORY (مخزون العقارات)
    match /properties/{propId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.admin == true || isAdmin());
    }

    // 🔔 4. NOTIFICATIONS & AUDIT LOGS (سجل الإشعارات)
    match /notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    // ⚙️ 5. SITE & FOUNDER SETTINGS (إعدادات الموقع والمؤسس وأرقام التواصل الحية)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}


