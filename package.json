{
  "name": "oneline-solutions-sohag",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/postbuild-seo.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "emulators:journey": "npx -y firebase-tools@15 emulators:start --only firestore,auth --project line-c9601",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore,auth --project line-c9601 \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "prepare": "git config core.hooksPath .githooks && git config commit.template .gitmessage || true",
    "check:commits": "node scripts/check-commit-message.mjs --range"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "dompurify": "^3.4.14",
    "firebase": "^12.15.0",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cypress": "^16.1.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "allowScripts": {
    "cypress@16.1.1": true
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
